# ローカルで試す時だけ使う(.env にコピーして値を埋める)
# GitHub Actionsで動かす本番運用ではこのファイルは使わず、リポジトリの Secrets に登録する

# 楽天ウェブサービス (https://webservice.rakuten.co.jp/) で取得(2026年新仕様: アプリケーションID)
RAKUTEN_APP_ID=
# 同じ画面で発行される accessKey (pk_ から始まる文字列、2026年API移行で必須)
RAKUTEN_ACCESS_KEY=
# 楽天アフィリエイト (https://affiliate.rakuten.co.jp/) で取得したID(必須ではないが無いと成果が発生しない)
RAKUTEN_AFFILIATE_ID=

# Google AI Studio (https://aistudio.google.com/apikey) で取得(任意)
# 設定するとAIが商品説明から一言コメントを生成して投稿文に添える。無くても動く(コメント無しの従来テンプレート)
GEMINI_API_KEY=

# true にするとpool.jsonを更新せず、内容だけコンソールに表示する
DRY_RUN=true
